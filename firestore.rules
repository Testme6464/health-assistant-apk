rules_version = '2';

// Health Assistant — Firestore rules.
// A user can only read/write their own subtree: users/{theirUid}/...
// Deploy in Firebase console (Firestore > Rules) or with the Firebase CLI.
// Default production-mode rules deny everything; these replace them.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
